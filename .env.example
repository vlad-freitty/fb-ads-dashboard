# On Vercel set these in Project -> Settings -> Environment Variables. Never commit real values.

# Meta system-user token (ads_read)
META_ACCESS_TOKEN=
META_API_VERSION=v24.0
# Optional: comma-separated ad account ids (act_123,act_456). Empty = every account the token sees.
META_AD_ACCOUNT_IDS=

# Neon Postgres (the Vercel Neon integration sets DATABASE_URL for you)
DATABASE_URL=

# Vercel sends "Authorization: Bearer <CRON_SECRET>" to the daily cron route. Random string.
CRON_SECRET=

# Microsoft sign-in (same scheme as the GBP dashboard). Until the first three are set the site is closed.
AUTH_TENANT_ID=
AUTH_CLIENT_ID=
# random string, 32+ characters
SESSION_SECRET=
# optional: only these e-mails may sign in (comma-separated)
ALLOWED_EMAILS=
# optional: sign-in lasts 12 hours by default
SESSION_HOURS=

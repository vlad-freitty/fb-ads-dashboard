# Copy to .env.local for local runs. On Vercel set these in Project Settings -> Environment Variables.
# Never commit real values.

# Meta system-user token (ads_read)
META_ACCESS_TOKEN=
META_API_VERSION=v24.0
# Optional: comma-separated ad account ids (act_123,act_456). Empty = every account the token sees.
META_AD_ACCOUNT_IDS=

# Neon Postgres connection string (the Vercel Neon integration sets DATABASE_URL for you)
DATABASE_URL=

# Vercel sends "Authorization: Bearer <CRON_SECRET>" to the cron route. Any long random string.
CRON_SECRET=

# Microsoft Entra sign-in (Auth.js). Until all four are set the site is closed for everyone.
AUTH_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# https://login.microsoftonline.com/<Directory (tenant) ID>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
